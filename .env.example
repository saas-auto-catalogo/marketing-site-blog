# Frontend app URL for register/login CTAs
VITE_APP_URL=http://127.0.0.1:5173

# Sentry (vazio = SDK desligado). Em CD, mapear secret VITE_SENTRY_DSN_MARKETING → VITE_SENTRY_DSN
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=drivesync@git-sha
#
# Upload de source maps no build (VPS/.sentry.env ou CI):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=drivesyncme
# SENTRY_PROJECT=drivesync-marketing
